# Copy to .env (never commit it). Used for local runs and as the production checklist.
SPRING_PROFILES_ACTIVE=dev

DB_URL=jdbc:postgresql://localhost:5432/rentivo
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Required in prod, 32+ random characters:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=1440

# Comma-separated browser origins allowed to call the API (empty = same-origin only)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: creates this admin account on first start (sign in via OTP)
BOOTSTRAP_ADMIN_PHONE=

UPLOAD_DIR=./uploads

# Media storage: STORAGE_PROVIDER=local (default in dev) or s3 (default in prod).
# For s3: set S3_BUCKET and AWS_REGION. AWS credentials are NOT set here — they come from
# the environment (AWS CLI config, env vars) locally, or an instance/task role in AWS.
# S3_PUBLIC_BASE_URL is optional: point it at a CloudFront domain in front of the bucket.
STORAGE_PROVIDER=local
S3_BUCKET=
AWS_REGION=ap-south-1
S3_PUBLIC_BASE_URL=

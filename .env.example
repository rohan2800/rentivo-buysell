# Copy to .env (never commit it). Used for local runs and as the production checklist.
SPRING_PROFILES_ACTIVE=dev

DB_URL=jdbc:postgresql://localhost:5432/rentivo
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Required in prod, 32+ random characters:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=1440

# Comma-separated browser origins allowed to call the API (empty = same-origin only)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: creates this admin account on first start (sign in via OTP)
BOOTSTRAP_ADMIN_PHONE=

UPLOAD_DIR=./uploads
